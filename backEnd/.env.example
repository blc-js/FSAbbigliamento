# Copia questo file in ".env" (non va mai committato) e sostituisci i valori.

# Genera una chiave con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-questa-chiave

# True solo in sviluppo locale. In produzione lascia False (o non impostarlo).
DEBUG=True

# Solo produzione: host e origini del deploy, separati da virgola.
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# CORS_ALLOWED_ORIGINS=https://mio-frontend.vercel.app

# Solo produzione: PostgreSQL (es. Supabase). Se manca, in locale si usa SQLite.
# DATABASE_URL=postgresql://utente:password@host:5432/nome_db

# Impostata da Render in automatico, non serve scriverla: RENDER_EXTERNAL_HOSTNAME
